import java.util.*;

public class MainLabA1 {

    public static void main(String[] args) {
        System.out.println("=== LABORATÓRIO DE COLEÇÕES & ESTRUTURAS DE DADOS ===");

        System.out.println("--- BLOCO A: Collections & List ---");
        tarefaA1();

        System.out.println("=== FIM DO LABORATÓRIO ===");
    }

    // ========== BLOCO A - Collections & List ==========

    /**
     * Tarefa A1: Operações básicas com Collections
     * - sort, binarySearch, reverse, shuffle
     */
    public static void tarefaA1() {
        System.out.println("[Tarefa A1] Operações com Collections");

        List<Integer> numeros = new ArrayList<>(Arrays.asList(5, 2, 8, 1, 9));
        System.out.println("Lista original: " + numeros);

        Collections.sort(numeros);
        System.out.println("Após sort(): " + numeros);

        int valorBusca = 8;
        int indice = Collections.binarySearch(numeros, valorBusca);
        System.out.println("binarySearch(" + valorBusca + "): índice = " + indice);

        Collections.reverse(numeros);
        System.out.println("Após reverse(): " + numeros);

        Collections.shuffle(numeros);
        System.out.println("Após shuffle(): " + numeros);

    }

}

